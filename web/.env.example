# Copy to .env.local (never commit real values). Everything is optional: with none of these set the app runs
# on the bundled snapshot with rule-based triage and estimated travel times (capability tier 3).

# --- Databricks (tier 2 and 1) ---------------------------------------------------------------------------------------
DATABRICKS_HOST=https://<your-workspace>.cloud.databricks.com
# Preferred: a service principal with an OAuth secret (Settings > Identity and access > Service principals)
DATABRICKS_CLIENT_ID=
DATABRICKS_CLIENT_SECRET=
# Last resort only: a personal access token
DATABRICKS_TOKEN=
# Name of a chat model serving endpoint in YOUR workspace (check the Serving page; not assumed)
FM_ENDPOINT=
# SQL warehouse for reading the facilities table (tier 1)
DATABRICKS_WAREHOUSE_ID=

# --- Live traffic (optional) ------------------------------------------------------------------------------------------
# google | mapbox | none. Adapters follow each vendor's documented format but are untested against a real key.
TRAFFIC_PROVIDER=none
TRAFFIC_API_KEY=
TRAFFIC_DAILY_LIMIT=400

# --- Data location (defaults to ./data) -------------------------------------------------------------------------------
# SNAPSHOT_DIR=
